@model List<RaceDay.MVC.ViewModels.EventVm>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">My Events</h2>
        <a asp-action="CreateEvent" class="btn btn-primary">+ Create event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No events yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Banner</th>
                        <th>Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Enrolments</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl))
                            {
                                <img src="@ev.BannerImageUrl" style="width:60px;height:40px;object-fit:cover;border-radius:4px;" />
                            }
                            else
                            {
                                <span class="text-muted small">no banner</span>
                            }
                        </td>
                        <td><strong>@ev.Name</strong></td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.Location</td>
                        <td><span class="badge bg-primary">@ev.EventType</span></td>
                        <td>@ev.EnrolmentCount</td>
                        <td class="text-end">
                            <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-controller="Categories" asp-action="Manage" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-info">Categories</a>
                            <a asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-primary">Enrolments</a>
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>