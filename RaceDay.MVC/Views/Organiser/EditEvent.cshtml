@model RaceDay.MVC.ViewModels.CreateEventVm
@{
    ViewData["Title"] = "Edit Event";
    var eventId = (int)ViewData["EventId"]!;
    var existingBanner = ViewData["ExistingBanner"] as string;
}

<div class="container mt-4">
    <h2>Edit Event</h2>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="EditEvent" asp-route-id="@eventId" method="post" enctype="multipart/form-data" class="card shadow-sm p-4">
        @Html.AntiForgeryToken()

        @if (!string.IsNullOrWhiteSpace(existingBanner))
        {
            <div class="mb-3">
                <label class="form-label">Current banner</label><br />
                <img src="@existingBanner" style="max-height:120px;border-radius:6px;" />
            </div>
        }

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Event name</label>
            <input asp-for="Name" class="form-control" required maxlength="150" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4" required maxlength="2000"></textarea>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" required />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" required maxlength="200" />
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Distance" class="form-label">Distance (km)</label>
                <input asp-for="Distance" type="number" step="0.1" min="0.1" class="form-control" required />
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Replace banner (optional)</label>
            <input type="file" name="banner" class="form-control" accept="image/*" />
        </div>

        <div>
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="MyEvents" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>