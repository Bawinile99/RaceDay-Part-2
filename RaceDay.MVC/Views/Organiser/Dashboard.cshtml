@model List<RaceDay.MVC.ViewModels.EventVm>
@{
    ViewData["Title"] = "Organiser Dashboard";
    int totalEvents = ViewBag.TotalEvents ?? 0;
    int totalEnrolments = ViewBag.TotalEnrolments ?? 0;
    int upcoming = ViewBag.UpcomingCount ?? 0;
}

<div class="container mt-4">
    <h2 class="mb-4">Organiser Dashboard</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm text-white" style="background:linear-gradient(135deg,#0d6efd,#0dcaf0);">
                <div class="card-body">
                    <div class="small text-uppercase">Total Events</div>
                    <div class="display-5 fw-bold">@totalEvents</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm text-white" style="background:linear-gradient(135deg,#198754,#20c997);">
                <div class="card-body">
                    <div class="small text-uppercase">Total Enrolments</div>
                    <div class="display-5 fw-bold">@totalEnrolments</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm text-white" style="background:linear-gradient(135deg,#6f42c1,#d63384);">
                <div class="card-body">
                    <div class="small text-uppercase">Upcoming</div>
                    <div class="display-5 fw-bold">@upcoming</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Your Events</h4>
        <a asp-action="CreateEvent" class="btn btn-primary">+ Create event</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">You haven't created any events yet. Click <strong>Create event</strong> to get started.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var ev in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" class="card-img-top" style="height:150px;object-fit:cover;" alt="@ev.Name" />
                        }
                        <div class="card-body">
                            <span class="badge bg-primary mb-2">@ev.EventType</span>
                            <h5 class="card-title">@ev.Name</h5>
                            <p class="card-text small text-muted mb-1">
                                @ev.EventDate.ToString("ddd, dd MMM yyyy")<br />
                                @ev.Location · @ev.Distance km
                            </p>
                            <p class="card-text small"><strong>@ev.EnrolmentCount</strong> enrolled</p>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-controller="Categories" asp-action="Manage" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-info">Categories</a>
                            <a asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-outline-primary">Enrolments</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>