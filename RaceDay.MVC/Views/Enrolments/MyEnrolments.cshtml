@model List<RaceDay.MVC.ViewModels.EnrolmentVm>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My Enrolments</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You haven't enrolled in any events yet.
            <a asp-controller="Home" asp-action="Index">Browse events</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var e in Model)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title mb-1">@e.EventName</h5>
                                    <div class="text-muted small">@e.CategoryName</div>
                                </div>
                                @switch (e.Status)
                                {
                                    case "Confirmed":
                                        <span class="badge bg-success">Confirmed</span>
                                        break;
                                    case "Pending":
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@e.Status</span>
                                        break;
                                }
                            </div>
                            <p class="small text-muted mb-2 mt-2">
                                Enrolled on @e.EnrolmentDate.ToString("dd MMM yyyy")
                            </p>
                        </div>
                        <div class="card-footer bg-white">
                            <form asp-action="Cancel" asp-route-id="@e.EnrolmentId" method="post"
                                  onsubmit="return confirm('Cancel this enrolment?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel enrolment</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>