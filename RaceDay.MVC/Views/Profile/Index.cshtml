@model RaceDay.MVC.ViewModels.UpdateProfileVm
@{
    ViewData["Title"] = "My Profile";
    var pictureUrl = ViewData["ProfilePictureUrl"] as string;
    var email = ViewData["Email"] as string;
    var role = ViewData["Role"] as string;
}

<div class="container mt-4">
    <h2>My Profile</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body text-center">
                    @if (!string.IsNullOrWhiteSpace(pictureUrl))
                    {
                        <img src="@pictureUrl" class="rounded-circle mb-3" style="width:140px;height:140px;object-fit:cover;" alt="Profile picture" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:140px;height:140px;font-size:48px;">👤</div>
                    }
                    <h5 class="mb-0">@Model.FirstName @Model.LastName</h5>
                    <div class="text-muted">@email</div>
                    <span class="badge bg-primary mt-2">@role</span>

                    <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="file" name="file" class="form-control mb-2" accept="image/*" />
                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">Upload picture</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Edit details</h5>
                    <form asp-action="Index" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="alert alert-danger">
                                @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                                {
                                    <div>@err.ErrorMessage</div>
                                }
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>